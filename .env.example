# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Data: Zetaris -----------------------------------------------------------
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# --- Power: Nemotron ---------------------------------------------------------
# All three MUST come from the same route. Mixing a Meterless key with NVIDIA's
# address is the most common failure. See BUILD-PLAN.md section 6.
#   NVIDIA free API : https://integrate.api.nvidia.com/v1
#   Meterless local : http://127.0.0.1:8088/v1   (needs Nightshift running)
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_KEY=nvapi-your-key-here
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# Per-tier models. NOT optional in practice -- measured on a single 120B
# vision-language model, the router alone took 103 seconds and spent 1093
# reasoning tokens deciding a name was not generic.
#
# The ladder that matters is ACTIVE parameters, not total:
#   lightning-30b-a3b   3B active  -> fast, for extraction and routing
#   super-vl-120b-a12b 12B active  -> mid, and carries vision weights you
#                                     never use; prefer a text-only Super
#   ultra-550b-a55b    55B active  -> deep, contested adjudication only
#
# Start here, then measure and adjust. If lightning holds up on the critic,
# keep it there: a faster critic means more revision rounds in the same budget.
NEMOTRON_MODEL_NANO=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_MODEL_SUPER=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_MODEL_ULTRA=nvidia/nemotron-3-ultra-550b-a55b

# Embedding model for candidate generation (Day 3-4). Not a chat model: it
# cannot run an agent, but it replaces crude substring matching in
# search_sanctions with semantic blocking, which is what catches
# transliterations that token overlap misses.
NEMOTRON_EMBED_MODEL=nemotron-3-embed-1b

# System directive used to suppress deliberation on the NANO tier. Verify the
# token your model actually honours on its build.nvidia.com model card.
NEMOTRON_NOTHINK_DIRECTIVE=/no_think

# --- Behaviour ---------------------------------------------------------------
# true = run entirely from data/sample and data/cache, no network. Keep this
# working all week; it is the demo's insurance policy.
SAMPLE_MODE=true
