# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Data: Zetaris -----------------------------------------------------------
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# --- Power: Nemotron ---------------------------------------------------------
# All three MUST come from the same route. Mixing a Meterless key with NVIDIA's
# address is the most common failure. See BUILD-PLAN.md section 6.
#   NVIDIA free API : https://integrate.api.nvidia.com/v1
#   Meterless local : http://127.0.0.1:8088/v1   (needs Nightshift running)
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_KEY=nvapi-your-key-here
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# Per-tier overrides. NOT optional in practice -- measured on a single 120B
# vision-language model, the router alone took 103 seconds and spent 1093
# reasoning tokens deciding a name was not generic. Point NANO at an actual
# Nemotron Nano and prefer a text-only Super over a VL variant: vision weights
# buy nothing here and cost latency on every call.
NEMOTRON_MODEL_NANO=
NEMOTRON_MODEL_SUPER=
NEMOTRON_MODEL_ULTRA=

# System directive used to suppress deliberation on the NANO tier. Verify the
# token your model actually honours on its build.nvidia.com model card.
NEMOTRON_NOTHINK_DIRECTIVE=/no_think

# --- Behaviour ---------------------------------------------------------------
# true = run entirely from data/sample and data/cache, no network. Keep this
# working all week; it is the demo's insurance policy.
SAMPLE_MODE=true
